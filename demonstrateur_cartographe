<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Cartographe CITISTATS — Cartes, calques et données en un clic</title>
<meta name="description" content="Découvrez le Cartographe CITISTATS : cartographie en ligne gratuite, sans installation. Calques, contours administratifs, données statistiques, isochrones, isodistances, import CSV et export PDF.">
<meta property="og:title" content="Cartographe CITISTATS — Cartes, calques et données en un clic">
<meta property="og:description" content="Fonds de carte, territoires, zones, données statistiques : composez vos cartes en ligne, sans installation.">
<meta name="theme-color" content="#0f766e">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
<style>
  /* ====== CHARTE : ajustez ces variables à votre site ====== */
  :root{
    --primary:#0f766e;       /* teal CITISTATS */
    --primary-dark:#0b5953;
    --primary-light:#e6f4f2;
    --accent:#f59e0b;
    --ink:#132a28;
    --muted:#5b6b69;
    --bg:#f5f8f8;
    --border:#dfe7e6;
    --radius:18px;
    --font:"Poppins",system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{margin:0;font-family:var(--font);color:var(--ink);background:var(--bg);line-height:1.6;font-size:16px;overflow-x:hidden}
  a{color:var(--primary)}
  .wrap{max-width:1180px;margin:0 auto;padding:0 16px}
  h1,h2,h3{line-height:1.2;margin:0}
  .eyebrow{display:inline-block;font-size:.76rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--primary);background:var(--primary-light);padding:5px 12px;border-radius:999px;margin-bottom:14px}
  .section{padding:74px 0}
  .alt{background:#fff}
  .section-head{text-align:center;max-width:700px;margin:0 auto 40px}
  .section-head h2{font-size:clamp(1.6rem,3.4vw,2.3rem);font-weight:800;margin-bottom:12px}
  .section-head p{color:var(--muted);margin:0;font-size:1.04rem}
  .btn{display:inline-flex;align-items:center;gap:8px;font-family:inherit;font-weight:600;font-size:.98rem;padding:12px 24px;border-radius:999px;text-decoration:none;border:2px solid transparent;cursor:pointer;transition:transform .15s,background .15s}
  .btn:hover{transform:translateY(-2px)}
  .btn-accent{background:var(--accent);color:var(--ink);box-shadow:0 8px 20px rgba(245,158,11,.35)}
  .btn-ghost{color:#fff;border-color:rgba(255,255,255,.55)}
  .btn-ghost:hover{background:rgba(255,255,255,.1)}

  /* ====== HERO ====== */
  .hero{background:radial-gradient(circle at 12% 20%,#14b8a6 0,transparent 42%),radial-gradient(circle at 88% 85%,#0e7490 0,transparent 45%),var(--primary-dark);color:#fff;padding:60px 0 80px;position:relative;overflow:hidden}
  .hero::before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.06) 1px,transparent 1px);background-size:44px 44px;mask-image:radial-gradient(circle at 70% 50%,#000 0,transparent 70%)}
  .hero-grid{position:relative;display:grid;grid-template-columns:1.05fr .95fr;gap:40px;align-items:center}
  @media (max-width:900px){.hero-grid{grid-template-columns:1fr;text-align:center}}
  .logo{font-weight:800;font-size:1.35rem;display:inline-flex;align-items:center;gap:10px;margin-bottom:24px;letter-spacing:.02em}
  .logo i{width:36px;height:36px;border-radius:10px;background:#fff;display:inline-flex;align-items:center;justify-content:center}
  .logo i svg{width:22px;height:22px;color:var(--primary)}
  .hero h1{font-size:clamp(1.9rem,4.6vw,3.1rem);font-weight:800;margin-bottom:16px}
  .hero h1 em{font-style:normal;color:#fcd34d}
  .hero .lead{font-size:1.1rem;color:#cdeeea;max-width:560px;margin:0 0 26px}
  @media (max-width:900px){.hero .lead{margin-left:auto;margin-right:auto}}
  .actions{display:flex;gap:12px;flex-wrap:wrap}
  @media (max-width:900px){.hero .actions{justify-content:center}}
  .pills{display:flex;gap:8px;flex-wrap:wrap;margin-top:26px}
  @media (max-width:900px){.pills{justify-content:center}}
  .pills span{background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.25);border-radius:999px;padding:5px 12px;font-size:.82rem}

  /* pile de calques animée */
  .stack{position:relative;height:330px;perspective:900px}
  .layer{position:absolute;left:50%;top:50%;width:300px;height:190px;margin:-95px 0 0 -150px;border-radius:16px;transform-style:preserve-3d;transition:transform .9s cubic-bezier(.2,.8,.2,1);box-shadow:0 18px 30px rgba(0,0,0,.25);display:flex;align-items:flex-end;padding:10px 14px;font-size:.78rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;overflow:hidden}
  .layer span{background:rgba(0,0,0,.35);padding:3px 9px;border-radius:999px;color:#fff;position:relative;z-index:2}
  .layer svg{position:absolute;inset:0;width:100%;height:100%}
  .stack .l1{transform:rotateX(58deg) rotateZ(-38deg) translateZ(-90px);background:#dfe9d8}
  .stack .l2{transform:rotateX(58deg) rotateZ(-38deg) translateZ(-30px);background:rgba(255,255,255,.18);border:2px solid rgba(255,255,255,.6)}
  .stack .l3{transform:rotateX(58deg) rotateZ(-38deg) translateZ(30px);background:rgba(20,184,166,.18);border:2px solid rgba(255,255,255,.4)}
  .stack .l4{transform:rotateX(58deg) rotateZ(-38deg) translateZ(90px);background:rgba(255,255,255,.06);border:2px dashed rgba(255,255,255,.6)}
  .stack.open .l1{transform:rotateX(58deg) rotateZ(-38deg) translateZ(-150px)}
  .stack.open .l2{transform:rotateX(58deg) rotateZ(-38deg) translateZ(-50px)}
  .stack.open .l3{transform:rotateX(58deg) rotateZ(-38deg) translateZ(50px)}
  .stack.open .l4{transform:rotateX(58deg) rotateZ(-38deg) translateZ(150px)}
  .stack-hint{text-align:center;font-size:.82rem;color:#cdeeea;margin-top:-10px}

  /* ====== DÉMO CARTE ====== */
  .demo{display:grid;grid-template-columns:300px 1fr;background:#fff;border:1px solid var(--border);border-radius:22px;overflow:hidden;box-shadow:0 25px 50px rgba(15,118,110,.12)}
  @media (max-width:900px){.demo{grid-template-columns:1fr}}
  .side{padding:18px;border-right:1px solid var(--border);max-height:620px;overflow:auto}
  @media (max-width:900px){.side{border-right:none;border-bottom:1px solid var(--border);max-height:none}}
  .grp{margin-bottom:16px}
  .grp h4{margin:0 0 8px;font-size:.74rem;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);display:flex;align-items:center;gap:6px}
  .grp h4 i{width:8px;height:8px;border-radius:2px;background:var(--primary);display:inline-block}
  .seg{display:flex;background:var(--bg);border-radius:10px;padding:3px;gap:3px}
  .seg button{flex:1;border:none;background:transparent;font:inherit;font-size:.8rem;padding:6px 4px;border-radius:8px;cursor:pointer;color:var(--ink)}
  .seg button.on{background:#fff;box-shadow:0 1px 4px rgba(0,0,0,.12);font-weight:600;color:var(--primary)}
  select{width:100%;padding:8px 10px;border:1px solid var(--border);border-radius:10px;font:inherit;font-size:.88rem;background:#fff;color:var(--ink)}
  .ds{display:flex;align-items:center;gap:10px;width:100%;border:1px solid var(--border);background:#fff;border-radius:12px;padding:9px 10px;margin-bottom:7px;cursor:pointer;font:inherit;text-align:left;color:var(--ink);transition:border-color .15s,background .15s}
  .ds:hover{border-color:var(--primary)}
  .ds .ic{flex:none;width:32px;height:32px;border-radius:9px;background:var(--primary-light);color:var(--primary);display:flex;align-items:center;justify-content:center}
  .ds .ic svg{width:17px;height:17px}
  .ds b{display:block;font-size:.86rem;line-height:1.25}
  .ds small{display:block;font-size:.72rem;color:var(--muted);line-height:1.3}
  .ds .tg{margin-left:auto;flex:none;width:38px;height:22px;border-radius:999px;background:#d5dddc;position:relative;transition:background .2s}
  .ds .tg::after{content:"";position:absolute;top:3px;left:3px;width:16px;height:16px;border-radius:50%;background:#fff;transition:left .2s}
  .ds.on{border-color:var(--primary);background:var(--primary-light)}
  .ds.on .tg{background:var(--primary)}
  .ds.on .tg::after{left:19px}
  .ds.loading .tg{background:var(--accent)}
  .radii{display:flex;gap:6px;margin-top:6px}
  .radii input{width:100%;padding:6px 8px;border:1px solid var(--border);border-radius:8px;font:inherit;font-size:.82rem}
  .small{font-size:.76rem;color:var(--muted);margin:6px 0 0}
  .mapbox{position:relative;min-height:620px}
  @media (max-width:900px){.mapbox{min-height:460px}}
  #map{position:absolute;inset:0;background:#e8eeee}
  .legend-box{position:absolute;right:12px;bottom:26px;z-index:500;background:rgba(255,255,255,.95);border-radius:12px;padding:10px 12px;font-size:.75rem;box-shadow:0 4px 14px rgba(0,0,0,.15);max-width:220px;display:none}
  .legend-box.show{display:block}
  .legend-box h5{margin:0 0 6px;font-size:.78rem}
  .legend-box .row{display:flex;align-items:center;gap:6px;margin:2px 0}
  .legend-box .sw{width:16px;height:12px;border-radius:2px;flex:none}
  .zone-info{position:absolute;left:56px;top:12px;z-index:500;background:rgba(255,255,255,.96);border-radius:12px;padding:10px 14px;font-size:.82rem;box-shadow:0 4px 14px rgba(0,0,0,.15);max-width:280px;display:none}
  .zone-info.show{display:block}
  .zone-info b{color:var(--primary)}
  .map-msg{position:absolute;left:50%;top:14px;transform:translateX(-50%);z-index:600;background:var(--ink);color:#fff;font-size:.82rem;padding:7px 14px;border-radius:999px;opacity:0;transition:opacity .25s;pointer-events:none;white-space:nowrap;max-width:90%;overflow:hidden;text-overflow:ellipsis}
  .map-msg.show{opacity:1}
  .click-hint{position:absolute;left:50%;bottom:26px;transform:translateX(-50%);z-index:500;background:var(--primary);color:#fff;font-size:.82rem;font-weight:600;padding:8px 16px;border-radius:999px;box-shadow:0 6px 16px rgba(15,118,110,.4);animation:pulse 2s ease-in-out infinite}
  @keyframes pulse{0%,100%{transform:translateX(-50%) scale(1)}50%{transform:translateX(-50%) scale(1.05)}}
  .demo-note{font-size:.78rem;color:var(--muted);text-align:center;margin-top:12px}

  /* ====== LÉGENDE 7 GROUPES ====== */
  .groups{display:grid;grid-template-columns:repeat(7,1fr);gap:12px}
  @media (max-width:960px){.groups{grid-template-columns:repeat(4,1fr)}}
  @media (max-width:560px){.groups{grid-template-columns:repeat(2,1fr)}}
  .g{background:#fff;border:1px solid var(--border);border-radius:16px;padding:18px 10px;text-align:center;transition:transform .2s,box-shadow .2s}
  .g:hover{transform:translateY(-5px) rotate(-1deg);box-shadow:0 14px 28px rgba(15,118,110,.14)}
  .g .ic{width:48px;height:48px;margin:0 auto 10px;border-radius:14px;background:var(--primary-light);color:var(--primary);display:flex;align-items:center;justify-content:center}
  .g .ic svg{width:24px;height:24px}
  .g b{display:block;font-size:.95rem}
  .g small{display:block;font-size:.75rem;color:var(--muted);line-height:1.35;margin-top:3px}

  /* ====== FONCTIONS ====== */
  .feats{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
  @media (max-width:960px){.feats{grid-template-columns:repeat(2,1fr)}}
  @media (max-width:560px){.feats{grid-template-columns:1fr}}
  .f{background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:22px 20px;transition:transform .2s}
  .f:hover{transform:translateY(-4px)}
  .f .ic{width:46px;height:46px;border-radius:13px;background:var(--primary);color:#fff;display:flex;align-items:center;justify-content:center;margin-bottom:12px}
  .f .ic svg{width:22px;height:22px}
  .f h3{font-size:1rem;margin-bottom:6px}
  .f p{margin:0;color:var(--muted);font-size:.88rem}

  /* ====== USAGES ====== */
  .uses{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
  @media (max-width:900px){.uses{grid-template-columns:repeat(2,1fr)}}
  @media (max-width:520px){.uses{grid-template-columns:1fr}}
  .u{border-radius:var(--radius);padding:22px;color:#fff}
  .u:nth-child(1){background:linear-gradient(135deg,#0f766e,#14b8a6)}
  .u:nth-child(2){background:linear-gradient(135deg,#0e7490,#0891b2)}
  .u:nth-child(3){background:linear-gradient(135deg,#365314,#65a30d)}
  .u:nth-child(4){background:linear-gradient(135deg,#b45309,#f59e0b)}
  .u h3{font-size:1.05rem;margin-bottom:6px}
  .u p{margin:0;font-size:.9rem;opacity:.93}

  /* ====== COMPTE ====== */
  .plans{max-width:860px;margin:0 auto;background:#fff;border:1px solid var(--border);border-radius:var(--radius);overflow:hidden}
  .plans table{width:100%;border-collapse:collapse;font-size:.92rem}
  .plans th,.plans td{padding:12px 16px;border-bottom:1px solid var(--border);text-align:left}
  .plans th{background:var(--bg);font-size:.82rem;text-transform:uppercase;letter-spacing:.05em;color:var(--muted)}
  .plans th.hl,.plans td.hl{background:var(--primary-light)}
  .plans th.hl{color:var(--primary)}
  .plans tr:last-child td{border-bottom:none}
  .yes{color:var(--primary);font-weight:700}
  .no{color:#9aa8a6}

  .cta{background:radial-gradient(circle at 85% 20%,#14b8a6 0,transparent 50%),var(--primary-dark);color:#fff;text-align:center;border-radius:28px;padding:54px 22px;margin:0 16px 70px}
  .cta h2{font-size:clamp(1.5rem,3.4vw,2.2rem);font-weight:800;margin-bottom:10px}
  .cta p{color:#cdeeea;margin:0 auto 24px;max-width:600px}
  .cta .actions{justify-content:center}
  footer{text-align:center;color:var(--muted);font-size:.85rem;padding:0 16px 40px}

  .reveal{opacity:0;transform:translateY(24px);transition:opacity .7s,transform .7s}
  .reveal.in{opacity:1;transform:none}
  @media (prefers-reduced-motion:reduce){*{animation:none !important;transition:none !important}.reveal{opacity:1;transform:none}}
</style>
</head>
<body>

<!-- ====== HERO ====== -->
<header class="hero">
  <div class="wrap hero-grid">
    <div>
      <div class="logo"><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m16.2 7.8-2.1 6.3-6.3 2.1 2.1-6.3z"/></svg></i>Cartographe CITISTATS</div>
      <h1>Superposez vos <em>calques</em>, ajoutez vos données, partagez votre carte</h1>
      <p class="lead">Un outil de cartographie en ligne, gratuit et sans installation : fonds de carte, contours administratifs, zones d'attraction et données statistiques s'empilent d'un clic.</p>
      <div class="actions">
        <a class="btn btn-accent" href="https://citistats.fr/cartographe/carte/?utm_source=github&amp;utm_medium=module&amp;utm_campaign=decouverte-cartographe" target="_blank" rel="noopener">Ouvrir le Cartographe</a>
        <a class="btn btn-ghost" href="#demo">Essayer la démo</a>
      </div>
      <div class="pills"><span>Isochrones</span><span>Isodistances</span><span>Contours</span><span>Import CSV</span><span>Export PDF</span></div>
    </div>
    <div>
      <div class="stack" id="stack" aria-hidden="true">
        <div class="layer l1"><svg viewBox="0 0 300 190" preserveAspectRatio="none"><path d="M0 120 C60 90 90 150 150 120 S250 60 300 90 V190 H0z" fill="#b9d3a7"/><path d="M0 40 C70 70 120 20 180 50 S260 30 300 50" fill="none" stroke="#7fb3d5" stroke-width="6"/><path d="M20 0 L80 190 M150 0 L140 190 M230 0 L260 190 M0 100 L300 140" stroke="#fff" stroke-width="3"/></svg><span>Fonds</span></div>
        <div class="layer l2"><svg viewBox="0 0 300 190" preserveAspectRatio="none"><path d="M30 30 L120 20 L150 80 L90 120 L20 100 Z M150 80 L240 40 L280 110 L200 160 L120 150 L90 120" fill="none" stroke="#fff" stroke-width="2.5" stroke-dasharray="6 4"/></svg><span>Territoires</span></div>
        <div class="layer l3"><svg viewBox="0 0 300 190" preserveAspectRatio="none"><circle cx="150" cy="95" r="80" fill="rgba(20,184,166,.25)" stroke="#5eead4" stroke-width="2"/><circle cx="150" cy="95" r="50" fill="rgba(20,184,166,.35)" stroke="#5eead4" stroke-width="2"/><circle cx="150" cy="95" r="22" fill="rgba(20,184,166,.55)" stroke="#5eead4" stroke-width="2"/></svg><span>Zones</span></div>
        <div class="layer l4"><svg viewBox="0 0 300 190" preserveAspectRatio="none"><path d="M60 140 L130 90" stroke="#fcd34d" stroke-width="4" marker-end="url(#ah)"/><defs><marker id="ah" markerWidth="8" markerHeight="8" refX="5" refY="4" orient="auto"><path d="M0 0 L8 4 L0 8z" fill="#fcd34d"/></marker></defs><circle cx="150" cy="95" r="7" fill="#fcd34d"/><text x="165" y="80" fill="#fff" font-size="16" font-family="Poppins,Arial" font-weight="700">Mon site</text></svg><span>Textes &amp; icônes</span></div>
      </div>
      <div class="stack-hint">Survolez la pile pour écarter les calques</div>
    </div>
  </div>
</header>

<!-- ====== DÉMO ====== -->
<section class="section" id="demo">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">Démo interactive</span>
      <h2>Ajoutez des données d'un clic</h2>
      <p>Changez de fond, chargez les communes d'un département, colorez-les par densité, puis cliquez sur la carte pour tracer des zones et compter les habitants.</p>
    </div>
    <div class="demo reveal">
      <aside class="side">
        <div class="grp">
          <h4><i></i>Fonds</h4>
          <div class="seg" id="baseSeg">
            <button type="button" class="on" data-b="relief">Relief</button>
            <button type="button" data-b="sat">Satellite</button>
          </div>
        </div>
        <div class="grp">
          <h4><i></i>Territoire</h4>
          <select id="dep">
            <option value="33">Gironde (33)</option>
            <option value="13">Bouches-du-Rhône (13)</option>
            <option value="31">Haute-Garonne (31)</option>
            <option value="35">Ille-et-Vilaine (35)</option>
            <option value="44">Loire-Atlantique (44)</option>
            <option value="59">Nord (59)</option>
            <option value="67">Bas-Rhin (67)</option>
            <option value="69">Rhône (69)</option>
          </select>
        </div>
        <div class="grp">
          <h4><i></i>Jeux de données</h4>
          <button type="button" class="ds" data-ds="contours"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6l6-3 6 3 6-3v15l-6 3-6-3-6 3z"/><path d="M9 3v15M15 6v15"/></svg></span><span><b>Contours des communes</b><small>Limites administratives</small></span><span class="tg"></span></button>
          <button type="button" class="ds" data-ds="densite"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7" fill="currentColor"/><rect x="3" y="14" width="7" height="7" fill="currentColor" opacity=".4"/><rect x="14" y="14" width="7" height="7"/></svg></span><span><b>Densité de population</b><small>Carte choroplèthe, hab./km²</small></span><span class="tg"></span></button>
          <button type="button" class="ds" data-ds="pop"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="7" cy="15" r="4"/><circle cx="17" cy="9" r="6"/></svg></span><span><b>Population</b><small>Cercles proportionnels</small></span><span class="tg"></span></button>
        </div>
        <div class="grp">
          <h4><i></i>Zones — isodistances</h4>
          <p class="small" style="margin:0 0 4px">Rayons en km (jusqu'à 3 zones)</p>
          <div class="radii"><input type="number" min="0.5" step="0.5" id="r1" value="5"><input type="number" min="0.5" step="0.5" id="r2" value="10"><input type="number" min="0.5" step="0.5" id="r3" value="20"></div>
          <p class="small">Cliquez sur la carte pour placer le centre. Dans le Cartographe, vous disposez aussi des isochrones à pied, à vélo ou en voiture.</p>
        </div>
      </aside>
      <div class="mapbox">
        <div id="map"></div>
        <div class="map-msg" id="mapMsg"></div>
        <div class="zone-info" id="zoneInfo"></div>
        <div class="legend-box" id="legend"></div>
        <div class="click-hint" id="clickHint">Cliquez sur la carte pour tracer vos zones</div>
      </div>
    </div>
    <p class="demo-note">Démo simplifiée. Contours et populations : API Géo (geo.api.gouv.fr) · Fonds : OpenTopoMap, Esri.</p>
  </div>
</section>

<!-- ====== 7 GROUPES DE CALQUES ====== -->
<section class="section alt">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">Les calques</span>
      <h2>Sept familles de calques, une légende qui se construit seule</h2>
      <p>Chaque élément ajouté rejoint son groupe dans la légende : renommez-le, changez sa couleur, sa taille, son opacité ou masquez-le.</p>
    </div>
    <div class="groups">
