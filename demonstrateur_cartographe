<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<script>
(function(){
  'use strict';
  /* ====== Réglages ====== */
  const UTM = 'utm_source=github&utm_medium=module&utm_campaign=decouverte-cartographe';
  const SIGNUP_URL = 'https://citistats.fr/cartographe/carte/membres/index.php?mode=inscription&' + UTM; // à vérifier
  const API = 'https://geo.api.gouv.fr';
  const TEAL = ['#ccfbf1','#5eead4','#14b8a6','#0f766e','#134e4a'];

  const $  = (s, r=document) => r.querySelector(s);
  const $$ = (s, r=document) => Array.from(r.querySelectorAll(s));
  const fmt = n => Math.round(n).toLocaleString('fr-FR');
  const reduced = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
  $('#ctaSignup').href = SIGNUP_URL;

  /* ---------- Pile de calques du hero ---------- */
  const stack = $('#stack');
  stack.addEventListener('mouseenter', () => stack.classList.add('open'));
  stack.addEventListener('mouseleave', () => stack.classList.remove('open'));
  stack.addEventListener('click', () => stack.classList.toggle('open'));
  if (!reduced) setTimeout(() => { stack.classList.add('open'); setTimeout(() => stack.classList.remove('open'), 1600); }, 900);

  /* ---------- Apparitions ---------- */
  const io = 'IntersectionObserver' in window ? new IntersectionObserver(en => en.forEach(x => { if (x.isIntersecting) { x.target.classList.add('in'); io.unobserve(x.target); } }), {threshold:.12}) : null;
  $$('.reveal').forEach(el => io ? io.observe(el) : el.classList.add('in'));

  /* ---------- Carte ---------- */
  if (typeof L === 'undefined') { $('#mapMsg').textContent = 'La carte n\'a pas pu être chargée.'; $('#mapMsg').classList.add('show'); return; }
  const map = L.map('map', {zoomControl:true, scrollWheelZoom:false}).setView([44.84, -0.58], 9);
  map.on('focus', () => map.scrollWheelZoom.enable());
  const BASES = {
    relief: L.tileLayer('https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png', {maxZoom:17, attribution:'© OpenStreetMap, SRTM · © OpenTopoMap (CC-BY-SA)'}),
    sat: L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {maxZoom:19, attribution:'© Esri, Maxar, Earthstar Geographics'})
  };
  let base = BASES.relief.addTo(map);
  $('#baseSeg').addEventListener('click', e => {
    const b = e.target.closest('[data-b]'); if (!b) return;
    $$('#baseSeg button').forEach(x => x.classList.toggle('on', x === b));
    map.removeLayer(base); base = BASES[b.dataset.b].addTo(map); base.bringToBack();
  });

  function msg(t, ms){
    const m = $('#mapMsg'); m.textContent = t; m.classList.add('show');
    clearTimeout(msg._t); if (ms) msg._t = setTimeout(() => m.classList.remove('show'), ms);
  }
  const hideMsg = () => $('#mapMsg').classList.remove('show');

  /* ---------- Données (API Géo) ---------- */
  const cache = {};
  async function loadDep(code){
    if (cache[code]) return cache[code];
    msg('Chargement des communes…');
    const [cont, cent] = await Promise.all([
      fetch(API + '/departements/' + code + '/communes?fields=nom,code,population,surface&format=geojson&geometry=contour').then(r => { if (!r.ok) throw 0; return r.json(); }),
      fetch(API + '/departements/' + code + '/communes?fields=nom,code,population&format=geojson&geometry=centre').then(r => { if (!r.ok) throw 0; return r.json(); })
    ]);
    cont.features.forEach(f => {
      const p = f.properties;
      p.densite = (p.population && p.surface) ? p.population / (p.surface / 100) : 0;
    });
    hideMsg();
    return (cache[code] = {cont, cent});
  }

  const layers = {contours:null, densite:null, pop:null};
  const active = new Set();

  function quantiles(vals, n){
    const s = vals.filter(v => v > 0).sort((a, b) => a - b), br = [];
    for (let i = 1; i < n; i++) br.push(s[Math.floor(s.length * i / n)]);
    return br;
  }
  const classOf = (v, br) => { let i = 0; while (i < br.length && v >= br[i]) i++; return i; };

  function build(id, data){
    if (id === 'contours') {
      return L.geoJSON(data.cont, {style:{color:'#0f766e', weight:1, fillOpacity:0, opacity:.8},
        onEachFeature:(f, l) => l.bindTooltip(f.properties.nom, {sticky:true})});
    }
    if (id === 'densite') {
      const br = quantiles(data.cont.features.map(f => f.properties.densite), 5);
      const lay = L.geoJSON(data.cont, {
        style: f => ({color:'#fff', weight:.5, fillColor:TEAL[classOf(f.properties.densite, br)], fillOpacity:.75}),
        onEachFeature:(f, l) => l.bindTooltip('<b>'+f.properties.nom+'</b><br>'+fmt(f.properties.densite)+' hab./km²', {sticky:true})
      });
      lay._breaks = br;
      return lay;
    }
    if (id === 'pop') {
      const max = Math.max(...data.cent.features.map(f => f.properties.population || 0));
      const g = L.layerGroup();
      data.cent.features.slice().sort((a, b) => (b.properties.population || 0) - (a.properties.population || 0)).forEach(f => {
        const p = f.properties.population || 0; if (!p) return;
        const c = f.geometry.coordinates;
        L.circleMarker([c[1], c[0]], {radius: 2 + 28 * Math.sqrt(p / max), color:'#b45309', weight:1, fillColor:'#f59e0b', fillOpacity:.55})
          .bindTooltip('<b>'+f.properties.nom+'</b><br>'+fmt(p)+' habitants').addTo(g);
      });
      g._max = max;
      return g;
    }
  }

  async function toggle(id, force){
    const btn = $('.ds[data-ds="'+id+'"]');
    const on = force !== undefined ? force : !active.has(id);
    if (!on) {
      if (layers[id]) map.removeLayer(layers[id]);
      active.delete(id); btn.classList.remove('on'); legend(); return;
    }
    btn.classList.add('loading');
    try {
      const data = await loadDep($('#dep').value);
      if (layers[id]) map.removeLayer(layers[id]);
      layers[id] = build(id, data).addTo(map);
      active.add(id); btn.classList.add('on');
      order();
      if (active.size === 1) map.fitBounds(L.geoJSON(data.cont).getBounds(), {padding:[10,10]});
      legend(); recount();
    } catch(e) {
      msg('Données indisponibles pour le moment (connexion à l\'API Géo).', 4000);
    }
    btn.classList.remove('loading');
  }
  function order(){
    if (layers.densite && active.has('densite')) layers.densite.bringToFront();
    if (layers.contours && active.has('contours')) layers.contours.bringToFront();
    if (zones) zones.eachLayer(l => l.bringToFront && l.bringToFront());
    if (layers.pop && active.has('pop')) layers.pop.eachLayer(l => l.bringToFront());
  }
  $$('.ds').forEach(b => b.addEventListener('click', () => toggle(b.dataset.ds)));
  $('#dep').addEventListener('change', async () => {
    const was = [...active];
    was.forEach(id => { map.removeLayer(layers[id]); layers[id] = null; });
    active.clear(); $$('.ds').forEach(b => b.classList.remove('on'));
    clearZones();
    if (!was.length) was.push('contours');
    for (const id of was) await toggle(id, true);
  });

  /* ---------- Légende auto ---------- */
  function legend(){
    const box = $('#legend'); let h = '';
    if (active.has('densite') && layers.densite) {
      const br = layers.densite._breaks, lab = [];
      for (let i = 0; i < 5; i++) lab.push(i === 0 ? '< ' + fmt(br[0]) : i === 4 ? '≥ ' + fmt(br[3]) : fmt(br[i-1]) + ' – ' + fmt(br[i]));
      h += '<h5>Densité (hab./km²)</h5>' + lab.map((l, i) => '<div class="row"><span class="sw" style="background:'+TEAL[i]+'"></span>'+l+'</div>').join('');
    }
    if (active.has('pop') && layers.pop) h += '<h5 style="margin-top:8px">Population</h5><div class="row"><span class="sw" style="background:#f59e0b;border-radius:50%;width:12px"></span>Cercle proportionnel (max. '+fmt(layers.pop._max)+')</div>';
    if (active.has('contours')) h += '<div class="row" style="margin-top:6px"><span class="sw" style="border:2px solid #0f766e;background:transparent"></span>Limites communales</div>';
    if (zones) h += '<h5 style="margin-top:8px">Isodistances</h5>' + zoneRadii.map((r, i) => '<div class="row"><span class="sw" style="background:'+ZC[i]+';opacity:.6"></span>'+String(r).replace('.', ',')+' km</div>').join('');
    box.innerHTML = h; box.classList.toggle('show', !!h);
  }

  /* ---------- Isodistances ---------- */
  const ZC = ['#0f766e','#14b8a6','#99f6e4'];
  let zones = null, zoneCenter = null, zoneRadii = [];
  function clearZones(){ if (zones) map.removeLayer(zones); zones = null; zoneCenter = null; $('#zoneInfo').classList.remove('show'); legend(); }
  function radii(){ return ['#r1','#r2','#r3'].map(s => parseFloat($(s).value)).filter(v => v > 0).sort((a, b) => a - b).slice(0, 3); }
  function drawZones(){
    if (!zoneCenter) return;
    if (zones) map.removeLayer(zones);
    zoneRadii = radii();
    zones = L.layerGroup();
    zoneRadii.slice().reverse().forEach((r, i) => {
      const idx = zoneRadii.length - 1 - i;
      L.circle(zoneCenter, {radius:r * 1000, color:ZC[idx], weight:2, fillColor:ZC[idx], fillOpacity:.12}).addTo(zones);
    });
    L.circleMarker(zoneCenter, {radius:6, color:'#fff', weight:2, fillColor:'#f59e0b', fillOpacity:1}).addTo(zones);
    zones.addTo(map);
    order(); legend(); recount();
  }
  function recount(){
    if (!zoneCenter) return;
    const data = cache[$('#dep').value];
    const box = $('#zoneInfo');
    if (!data) {
      box.innerHTML = 'Activez un jeu de données pour compter les communes et les habitants dans chaque zone.';
      box.classList.add('show'); return;
    }
    const rows = zoneRadii.map(r => {
      let n = 0, p = 0;
      data.cent.features.forEach(f => {
        const c = f.geometry.coordinates;
        if (map.distance(zoneCenter, [c[1], c[0]]) <= r * 1000) { n++; p += f.properties.population || 0; }
      });
      return '<div>À <b>'+String(r).replace('.', ',')+' km</b> : '+n+' commune'+(n > 1 ? 's' : '')+', <b>'+fmt(p)+'</b> hab.</div>';
    });
    box.innerHTML = rows.join('') + '<div style="font-size:.72rem;color:#5b6b69;margin-top:4px">Communes du département dont le centre est dans la zone</div>';
    box.classList.add('show');
  }
  map.on('click', e => {
    zoneCenter = e.latlng;
    $('#clickHint').style.display = 'none';
    drawZones();
  });
  ['#r1','#r2','#r3'].forEach(s => $(s).addEventListener('change', drawZones));

  /* Démarrage : contours de la Gironde dès que la démo est visible */
  let started = false;
  const start = () => { if (started) return; started = true; toggle('contours', true); };
  if ('IntersectionObserver' in window) {
    const o = new IntersectionObserver(en => { if (en[0].isIntersecting) { start(); o.disconnect(); } }, {threshold:.2});
    o.observe($('#map'));
  } else start();
})();
</script>
